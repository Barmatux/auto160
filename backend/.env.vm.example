POSTGRES_DB=auto160
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

DATABASE_URL=postgresql+psycopg2://postgres:change-me-db-password@db:5432/auto160
SECRET_KEY=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

BOOTSTRAP_ADMIN_EMAIL=admin@auto160.com
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_NAME=Auto160 Admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

CATALOG_SEED_CSV_PATH=app/data/catalog_u160_audi_bmw_mini.csv

# App media (/media/object): catalog + scrape-platform keys (auto24/, autoplius/, mobile_de/)
# Production: Yandex Object Storage. Local docker-compose may still use MinIO.
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=auto160-media
S3_REGION=ru-central1
S3_PRESIGN_EXPIRES_SECONDS=3600

# Legacy Autoplius listings/ keys → /media/autoplius (private autoplius-media bucket)
# AUTOPLIUS_S3_ENDPOINT_URL=https://storage.yandexcloud.net
# AUTOPLIUS_S3_ACCESS_KEY=
# AUTOPLIUS_S3_SECRET_KEY=
# AUTOPLIUS_S3_BUCKET=autoplius-media
# AUTOPLIUS_S3_REGION=ru-central1
# Required on Auto160 VM (private network to scrape-platform Postgres):
AUTOPLIUS_SCRAPE_DSN=postgresql://scrape:scrape@10.129.0.33:5433/scrape

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# Optional: auto-solve av.by reCAPTCHA when registering service accounts (2captcha / rucaptcha)
# CAPTCHA_2CAPTCHA_API_KEY=your-2captcha-api-key
# CAPTCHA_API_URL=https://2captcha.com

# Optional: personal av.by account for VIN testing (30 checks/day, not committed)
# AVBY_VIN_TEST_EMAIL=your@gmail.com
# AVBY_VIN_TEST_PASSWORD=your-password
# Or use data/avby_vin_test_credentials.json on the server (gitignored)

# Optional: HeroSMS virtual numbers for av.by phone verification (+375)
# HERO_SMS_API_KEY=your-hero-sms-api-key

# Optional: Weeek task board integration
# WEEEK_API_TOKEN=your-weeek-api-token

# Logging (files mounted to ~/auto160/logs on VM)
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# LOG_TIMEZONE=Europe/Minsk

# OpenAI-compatible embeddings + chat (OpenRouter)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_HTTP_PROXY=http://user:pass@host:port
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_PROVIDER=openai
# CHAT_MODEL=openai/gpt-4o-mini
# CHAT_ENABLED=true
# CHAT_RATE_LIMIT_PER_HOUR=30
# Without OPENAI_API_KEY the app falls back to local hash vectors (smoke only); chat stays off.

# Canonical public site URL for SEO (canonical, sitemap, OG). Must match nginx primary host.
PUBLIC_SITE_URL=https://auto160.ru

# Internal Catalog API for colocated eu2.by (X-Api-Key). Required for /api/v1/internal/catalog/*
INTERNAL_CATALOG_API_KEY=CHANGE_ME_LONG_RANDOM
# Optional app-level IP allowlist (comma-separated IPs/CIDRs). Empty = key-only; nginx still restricts private nets.
# INTERNAL_CATALOG_ALLOWED_IPS=127.0.0.1,10.0.0.0/8

# External Market Prices API (/api/v1/market/*). Public nginx path; protect with key (+ optional IP allowlist).
MARKET_PRICES_API_KEY=CHANGE_ME_LONG_RANDOM
# MARKET_PRICES_ALLOWED_IPS=1.2.3.4,10.0.0.0/8

# Yandex Metrika counter ID (https://metrika.yandex.ru)
# YANDEX_METRIKA_ID=12345678
